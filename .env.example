# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/footers?retryWrites=true&w=majority

# JWT secret
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=5000

# Allowed CORS origins (comma-separated). Leave blank to allow all during development.
CORS_ORIGIN=http://localhost:3000

# Max upload file size in bytes (default 5MB)
MAX_FILE_SIZE=5242880

# Logging level (info, debug, error)
LOG_LEVEL=info
