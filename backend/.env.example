PORT=5004
MONGO_URI=mongodb://localhost:27017/footers
NODE_ENV=development
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
MAX_FILE_SIZE=5242880
LOG_LEVEL=info
ADMIN_REG_CODE=

# App
APP_URL=http://localhost:3000

# Shipping (dummy | shiprocket | delhivery | bluedart)
SHIPPING_PROVIDER=dummy
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=99

# Tax
GST_RATE=0

# Image storage (local | cloudinary | s3 | firebase)
IMAGE_PROVIDER=local

# Email (optional — invoice skipped if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@footers.in

# Future courier integrations
# SHIPROCKET_API_KEY=
# DELHIVERY_API_KEY=
# BLUEDART_API_KEY=

# Future image storage
# CLOUDINARY_URL=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
